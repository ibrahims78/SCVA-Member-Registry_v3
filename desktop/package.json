{
  "name": "scva-members-desktop",
  "version": "1.4.0",
  "description": "نظام إدارة أعضاء الرابطة السورية لأمراض وجراحة القلب - تطبيق سطح المكتب",
  "main": "electron/main.js",
  "author": "SCVA",
  "license": "MIT",
  "scripts": {
    "build": "node build.js",
    "start": "electron ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.39.3",
    "express": "^5.0.1",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "memorystore": "^1.6.7",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "sql.js": "^1.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.19.0",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/sql.js": "^1.4.9",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "typescript": "5.6.3"
  },
  "build": {
    "appId": "com.scva.members",
    "productName": "SCVA Members",
    "copyright": "Copyright © 2024 SCVA",
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "output": "../releases/build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@types/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/renderer",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    }
  }
}
